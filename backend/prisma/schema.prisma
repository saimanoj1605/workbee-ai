generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  BUSINESS
  ADMIN
}

enum GigStatus {
  DRAFT
  OPEN
  CLOSED
  FILLED
}

enum ApplicationStatus {
  APPLIED
  REVIEWED
  INTERVIEW
  HIRED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  SYSTEM
  USER
  GIG
  PAYMENT
  REVIEW
}

enum ReputationLevel {
  NEW
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model User {
  id String @id @default(uuid())
  fullName String
  email String @unique
  passwordHash String
  role UserRole
  isEmailVerified Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student?
  business Business?
  reputation ReputationScore?
  notifications Notification[]
  reviewsAuthored Review[] @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewReceiver")

  @@index([role])
}

model Student {
  id String @id @default(uuid())
  user User @relation(fields: [userId], references: [id])
  userId String @unique
  headline String?
  bio String?
  skills String[] @default([])
  education String?
  location String?
  portfolioUrl String?
  availability String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
  aiMatches AIMatch[]

  @@index([location])
}

model Business {
  id String @id @default(uuid())
  user User @relation(fields: [userId], references: [id])
  userId String @unique
  businessName String
  about String?
  website String?
  industry String?
  location String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gigs Gig[]
  payments Payment[]

  @@index([industry])
}

model Gig {
  id String @id @default(uuid())
  business Business @relation(fields: [businessId], references: [id])
  businessId String
  title String
  description String
  requirements String?
  skills String[] @default([])
  location String?
  salaryRange String?
  status GigStatus @default(OPEN)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
  aiMatches AIMatch[]
  reviews Review[]

  @@index([businessId])
  @@index([status])
}

model Application {
  id String @id @default(uuid())
  gig Gig @relation(fields: [gigId], references: [id])
  gigId String
  student Student @relation(fields: [studentId], references: [id])
  studentId String
  status ApplicationStatus @default(APPLIED)
  coverLetter String?
  submittedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  matchedScore Float?

  payment Payment?

  @@index([gigId])
  @@index([studentId])
  @@index([status])
}

model Payment {
  id String @id @default(uuid())
  business Business? @relation(fields: [businessId], references: [id])
  businessId String? @unique
  application Application? @relation(fields: [applicationId], references: [id])
  applicationId String? @unique
  amount Float
  currency String @default("USD")
  status PaymentStatus @default(PENDING)
  transactionId String? @unique
  processedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id String @id @default(uuid())
  author User @relation("ReviewAuthor", fields: [authorId], references: [id])
  authorId String
  receiver User @relation("ReviewReceiver", fields: [receiverId], references: [id])
  receiverId String
  gig Gig? @relation(fields: [gigId], references: [id])
  gigId String?
  rating Int
  comment String?
  createdAt DateTime @default(now())
}

model Notification {
  id String @id @default(uuid())
  user User @relation(fields: [userId], references: [id])
  userId String
  title String
  message String
  type NotificationType @default(SYSTEM)
  isRead Boolean @default(false)
  metadata Json?
  actionUrl String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
}

model ReputationScore {
  id String @id @default(uuid())
  user User @relation(fields: [userId], references: [id])
  userId String @unique
  score Float @default(0)
  level ReputationLevel @default(NEW)
  reviewCount Int @default(0)
  updatedAt DateTime @updatedAt
}

model AIMatch {
  id String @id @default(uuid())
  student Student @relation(fields: [studentId], references: [id])
  studentId String
  gig Gig @relation(fields: [gigId], references: [id])
  gigId String
  score Float
  reason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, gigId])
}
