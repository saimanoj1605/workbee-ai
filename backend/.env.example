# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ============================================
# SERVER
# ============================================
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:3000"

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET="your_jwt_secret_min_32_chars_long_secure_random_string"
JWT_EXPIRES_IN="7d"

# ============================================
# FIREBASE AUTHENTICATION (OTP)
# ============================================
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ============================================
# CLOUDINARY (FILE STORAGE)
# ============================================
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ============================================
# PAYMENT GATEWAYS
# ============================================
# Razorpay
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."

# Stripe (optional backup)
STRIPE_SECRET_KEY="sk_test_..."

# ============================================
# AI SERVICES
# ============================================
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# ============================================
# CLERK (Optional - for web auth)
# ============================================
CLERK_SECRET_KEY="sk_test_..."

# ============================================
# GOOGLE MAPS (Geo Validation)
# ============================================
GOOGLE_MAPS_API_KEY="AIzaSy..."

# ============================================
# ANALYTICS (PostHog)
# ============================================
POSTHOG_API_KEY="phc_..."
POSTHOG_HOST="https://app.posthog.com"

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# CORS
# ============================================
CORS_ORIGIN="http://localhost:3000,https://workbee.vercel.app"

# ============================================
# SECURITY
# ============================================
BCRYPT_ROUNDS=12